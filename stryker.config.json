{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": [],
  "mutate": [
    "src/lib/**/*.ts",
    "src/scripts/**/*.ts",
    "src/site.ts",
    "src/components/**/*.{ts,tsx}",
    "!src/components/ui/**",
    "!src/**/*.astro"
  ],
  "ignorePatterns": [
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "reports",
    ".stryker-tmp"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "coverageAnalysis": "perTest",
  "concurrency": 4
}
