# Origin of the web app (mvp-web): "Sign in" and "Try it now" link to it. Build time.
PUBLIC_APP_URL=http://localhost:3000
# Optional public HTTPS link to the kit's source ("Get the source"). Blank hides it.
PUBLIC_REPOSITORY_URL=
# This site's own origin, for absolute og:image/twitter:image URLs.
PUBLIC_SITE_URL=http://localhost:4321
