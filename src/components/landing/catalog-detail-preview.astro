---
import Check from "@lucide/astro/icons/check"
import { Image } from "astro:assets"
import { demoProducts } from "@/data/demo-products"
import { formatPrice } from "@/lib/format"

const product = demoProducts[0]
// Fills about a third of the card (~240 CSS px at most).
---

<figure class="landing-detail-preview">
  <Image
    src={product.image}
    alt={product.alt}
    width={240}
    densities={[1, 2]}
    format="webp"
  />
  <figcaption>
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="font-medium text-sm">{product.name}</p>
        <p class="mt-1 text-muted-foreground text-xs">{product.sku}</p>
      </div>
      <span class="flex items-center gap-1 text-success text-xs">
        <Check class="size-3" aria-hidden="true" />
        Active
      </span>
    </div>
    <div class="mt-4 border-t pt-3">
      <span class="font-medium text-sm">{formatPrice(product.price)}</span>
    </div>
  </figcaption>
</figure>

<style>
  .landing-detail-preview {
    display: grid;
    grid-template-columns: minmax(5rem, 32%) 1fr;
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    color: var(--foreground);
  }
  .landing-detail-preview > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .landing-detail-preview figcaption {
    min-width: 0;
    padding: 1rem;
  }
  .landing-detail-preview figcaption > div:first-child {
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
