---
const steps = [
  {
    title: "Clone and run.",
    description:
      "Install with pnpm and uv, start Postgres and AWS emulators with Docker, then run each dev server.",
    command: "make up"
  },
  {
    title: "Build your feature.",
    description:
      "Change the API, fetch the spec, regenerate the client, then build each screen with its UI kit.",
    command: "pnpm api:fetch"
  },
  {
    title: "Ship it.",
    description:
      "Lint, types and tests run on every change. Deploy API, web, then landing.",
    command: "gh workflow run"
  }
]
---

<section
  id="how-it-works"
  aria-labelledby="workflow-heading"
  class="landing-section scroll-mt-10"
>
  <div class="landing-section-intro" data-reveal="true">
    <h2 id="workflow-heading" class="landing-section-heading">
      From clone
      <br />
      to launch.
    </h2>
    <p class="max-w-sm text-muted-foreground leading-relaxed">
      Four repositories, one package manager per language, and a pinned API spec
      that keeps the API and both apps in step.
    </p>
  </div>
  <ol class="landing-steps">
    {steps.map((step, index) => (
      <li data-reveal="true" data-reveal-delay={index * 80}>
        <span class="landing-step-number" aria-hidden="true">
          0{index + 1}
        </span>
        <h3 class="mt-3 font-medium text-lg">{step.title}</h3>
        <p class="mt-3 max-w-xs text-muted-foreground text-sm leading-relaxed">
          {step.description}
        </p>
        <code class="landing-step-command">{step.command}</code>
      </li>
    ))}
  </ol>
</section>

<style>
  .landing-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }
  .landing-steps li {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
  .landing-step-number {
    color: var(--primary);
    font-size: 0.875rem;
  }
  .landing-step-command {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
    font-family: var(--font-family-mono);
    font-size: 0.8125rem;
  }
  @media (max-width: 639px) {
    .landing-steps {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-top: 2.5rem;
    }
  }
</style>
