---
import { PUBLIC_REPOSITORY_URL } from "astro:env/client"
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right"
import Code from "@lucide/astro/icons/code"
import BrandLogo from "@/components/brand-logo.astro"
import { landingNavigation } from "@/data/navigation"
import { appEnabled, signInHref, primaryCta } from "@/lib/app-url"
import { site } from "@/site"

const repository = PUBLIC_REPOSITORY_URL
---

<footer class="landing-footer">
  <div class="landing-footer-main">
    <div>
      <a href="/" class="landing-brand">
        <BrandLogo decorative /> {site.name}
      </a>
      <p class="landing-footer-message">
        Start with what works.
        <br />
        Build what’s next.
      </p>
      <p class="mt-4 max-w-xs text-pretty text-muted-foreground text-sm leading-relaxed">
        A starter kit for products on the web, iOS and Android. Open source
        under the MIT license.
      </p>
    </div>
    <nav aria-labelledby="footer-product-heading">
      <h2 id="footer-product-heading">Explore</h2>
      <ul>
        {landingNavigation.map(({ label, hash }) => (
          <li>
            <a href={`/#${hash}`}>{label}</a>
          </li>
        ))}
        <li>
          <a href="/#customer-stories">Customer stories</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-start-heading">
      <h2 id="footer-start-heading">Get started</h2>
      <ul>
        <li>
          <a href={primaryCta.href}>
            {primaryCta.label}
            <ArrowUpRight class="size-3.5" aria-hidden="true" />
          </a>
        </li>
        {repository && (
          <li>
            <a href={repository} target="_blank" rel="noopener noreferrer">
              <Code class="size-4" aria-hidden="true" />
              Get the source
            </a>
          </li>
        )}
        {appEnabled && (
          <li>
            <a href={signInHref()}>
              Sign in
              <ArrowUpRight class="size-3.5" aria-hidden="true" />
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
  <div class="landing-footer-bottom">
    <p>© {site.name}. MIT licensed.</p>
    <p>Made for your next big idea.</p>
  </div>
</footer>

<style>
  .landing-footer {
    padding-block: 3rem 1.5rem;
  }
  .landing-footer-main {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    padding-bottom: 3.5rem;
  }
  .landing-footer-message {
    margin-top: 1.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 500;
    text-wrap: balance;
  }
  .landing-footer nav h2 {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .landing-footer nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .landing-footer nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .landing-footer nav a:hover {
    color: var(--primary);
  }
  .landing-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
  @media (max-width: 1023px) {
    .landing-footer-main {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 639px) {
    .landing-footer {
      padding-top: 3rem;
    }
    .landing-footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 1.25rem;
      padding-bottom: 2.5rem;
    }
    .landing-footer-main > div {
      grid-column: 1 / -1;
    }
    .landing-footer nav a {
      min-height: 2.75rem;
      font-size: 0.75rem;
    }
  }
</style>
